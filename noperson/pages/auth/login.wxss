/* pages/auth/login.wxss */
page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #1aad19 0%, #f8f8f8 30%);
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
  background: transparent;
  color: #fff;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.logo-image {
  width: 140rpx;
  height: 140rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.95;
  letter-spacing: 1rpx;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx 40rpx;
  background-color: #f8f8f8;
}

.role-list {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.role-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #fafafa, #fff);
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.role-item:last-child {
  margin-bottom: 0;
}

.role-item:active {
  transform: scale(0.98);
}

.role-item-selected {
  background: linear-gradient(135deg, #e6f7e6, #f0fff0);
  border-color: #1aad19;
}

.role-icon {
  width: 120rpx;
  height: 120rpx;
  margin-right: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.role-icon image {
  width: 100%;
  height: 100%;
}

.role-info {
  flex: 1;
}

.role-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.role-description {
  font-size: 26rpx;
  color: #666;
  line-height: 36rpx;
}

.role-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ccc;
}

.arrow-text {
  font-size: 36rpx;
  font-weight: bold;
}

.role-item-selected .arrow-text {
  color: #1aad19;
}



.footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.05);
}

.footer-text {
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

/* 微信登录弹窗 */
.wechat-login-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.dialog-content {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: dialog-appear 0.3s ease;
}

@keyframes dialog-appear {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.dialog-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 32rpx;
  background: linear-gradient(135deg, #1aad19, #16a085);
}

.wechat-logo {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 50%;
  padding: 10rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.dialog-body {
  padding: 40rpx;
  text-align: center;
}

.dialog-message {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.dialog-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.dialog-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.dialog-btn {
  flex: 1;
  padding: 32rpx 0;
  font-size: 32rpx;
  text-align: center;
  background: #fff;
  border: none;
  border-radius: 0;
}

.dialog-btn::after {
  border: none;
}

.dialog-btn.cancel {
  color: #666;
  border-right: 1rpx solid #eee;
}

.dialog-btn.confirm {
  color: #1aad19;
  font-weight: bold;
}

/* 加载中弹窗 */
.loading-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.loading-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 80rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #1aad19;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 30rpx;
  color: #333;
}