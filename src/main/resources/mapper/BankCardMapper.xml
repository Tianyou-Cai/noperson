<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cty.nopersonfinally.mapper.BankCardMapper">

    <!-- 根据用户ID查询银行卡列表 -->
    <select id="selectByUserId" resultType="com.cty.nopersonfinally.pojo.entity.BankCard">
        SELECT * FROM bank_card
        WHERE user_id = #{userId}
        ORDER BY is_default DESC, create_time DESC
    </select>

    <!-- 根据用户ID查询默认银行卡 -->
    <select id="selectDefaultByUserId" resultType="com.cty.nopersonfinally.pojo.entity.BankCard">
        SELECT * FROM bank_card
        WHERE user_id = #{userId} AND is_default = 1
        LIMIT 1
    </select>

</mapper>
